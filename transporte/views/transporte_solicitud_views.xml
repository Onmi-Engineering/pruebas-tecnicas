<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="oeng_transporte_solicitud_list" model="ir.ui.view">
            <field name="name">oeng.transporte.solicitud.list</field>
            <field name="model">transporte.solicitud</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="oeng_transporte_solicitud_form" model="ir.ui.view">
            <field name="name">oeng.transporte.solicitud.form</field>
            <field name="model">transporte.solicitud</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>

                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="oeng_transportes_transporte_solicitud_search" model="ir.ui.view">
            <field name="name">oeng.transportes.transporte.solicitud.search</field>
            <field name="model">transporte.solicitud</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="action_transporte_solicitud" model="ir.actions.act_window">
            <field name="name">Solicitudes de transporte</field>
            <field name="res_model">transporte.solicitud</field>
            <field name="view_mode">list,form,search</field>
            <field name="search_view_id" ref="oeng_transportes_transporte_solicitud_search"/>
        </record>
    </data>
</odoo>